+             * 任何一层都不会把电流打到 0：归零只由硬保护（input_suspend）负责。 */
+            {
+                double tgt = C.target_temp_x10 / 10.0;
+                long reg_min = (C.min_regulate_ma > 0) ? C.min_regulate_ma : C.min_ma;
+                double hit_s = -1.0;
